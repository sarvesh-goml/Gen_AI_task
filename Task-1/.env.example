# Copy to .env and adjust as needed. Every value here has a working local default -
# you generally only need to touch OLLAMA_MODEL if you pulled a different model.

# ---- Groq ----
GROQ_API_KEY=""
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Postgres (docker-compose) ----
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis
POSTGRES_DB=jarvis_fleet

# Admin/owner connection - used only by scripts/setup_db.py and scripts/seed_db.py.
# Host port is 5433 (not the default 5432) so this doesn't collide with a locally
# installed Postgres you might already have running - see docker-compose.yml.
DATABASE_URL=postgresql+psycopg://jarvis:jarvis@localhost:5433/jarvis_fleet

# Least-privilege role NL2SQL-generated SQL actually runs as (created by setup_db.py).
# Leave READONLY_DATABASE_URL blank to have it derived automatically from DATABASE_URL +
# these two values.
READONLY_DB_USER=jarvis_readonly
READONLY_DB_PASSWORD=jarvis_readonly_pw
READONLY_DATABASE_URL=

# ---- API / UI wiring ----
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
